void sendSensor(){
  

Blynk.virtualWrite(V2, humi);
Blynk.virtualWrite(V3, tempC);
Blynk.virtualWrite(V4, light_intens_per);
  
}

void loop() {
  Blynk.run();
  timer.run();
  read_sensors();
  lcd_data_display();
  
  delay(500);
}

void read_sensors()
{
  humi  = dht.readHumidity();
  tempC = dht.readTemperature();
  if (isnan(humi) || isnan(tempC)) {
    Serial.println("Failed to read from DHT sensor!");
  } else {
    Serial.print("Humidity: ");
    Serial.print(humi);
    Serial.print("%");

    Serial.print("  |  "); 

    Serial.print("Temperature: ");
    Serial.print(tempC);
    Serial.println("°C ~ ");
    
  }
   ldr_value=analogRead(ldr_pin);
    Serial.print("LDR: ");
    Serial.print(ldr_value);
  light_intens_per = map(ldr_value, 4095, 0, 0, 100);
}

void lcd_data_display()
{
  lcd.clear();
  int humidity = humi;
  int temp = tempC;
  lcd.setCursor(0,0); 
  lcd.print("H");
  lcd.setCursor(3,0); 
  lcd.print(humidity); 
  lcd.setCursor(6,0); 
  lcd.print("t");
  lcd.setCursor(8,0); 
  lcd.print(temp); 
  lcd.setCursor(11,0); 
  lcd.print("L:");
  lcd.setCursor(13,0); 
  lcd.print(light_intens_per);
   
  lcd.setCursor(0,1); 
  lcd.print("AZI");
  lcd.setCursor(5,1); 
  lcd.print(value1);
  lcd.setCursor(9,1); 
  lcd.print("ELE");
  lcd.setCursor(13,1); 
  lcd.print(value2);

}
